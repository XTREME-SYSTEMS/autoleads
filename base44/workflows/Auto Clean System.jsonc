{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_clean_system",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "clean": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoCleanSystem",
            "args": {
              "_service_token": ""
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Auto clean",
            "description": "Removes duplicates, stale records, example data, and fixes integrity issues"
          }
        }
      }
    ]
  },
  "name": "Auto Clean System",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 2 * * 0",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Weekly on Sunday at 2am ET \u2014 autonomous data cleaning: removes duplicates, stale records, NON_PRODUCTION_EXAMPLE data, orphaned takeoffs, and fixes integrity issues."
}