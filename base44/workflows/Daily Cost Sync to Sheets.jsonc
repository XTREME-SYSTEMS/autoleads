{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_cost_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_costs": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncCostsToSheets",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync costs to Google Sheets",
            "description": "Cost metrics + summary \u2192 sheet \u2192 email"
          }
        }
      }
    ]
  },
  "description": "Daily sync of cost metrics and financial summary to a Google Sheet, with the sheet URL emailed to jeremy@xtremepolishingsystems.com.",
  "name": "Daily Cost Sync to Sheets"
}