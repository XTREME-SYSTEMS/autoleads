{
  "description": "Daily at 6am ET \u2014 pushes notification with new bids matching the user's trade and total value",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "morning_lead_digest",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_digest": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "morningDigest",
            "args": {
              "_service_token": ""
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Morning digest",
            "description": "New bids + total value notification"
          }
        }
      }
    ]
  },
  "name": "Morning Lead Digest",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}