{
  "name": "ContractTemplate",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "trade": {
      "type": "string",
      "description": "Construction trade/scope this contract covers"
    },
    "contract_type": {
      "type": "string",
      "enum": [
        "commercial",
        "government",
        "residential",
        "industrial",
        "universal"
      ],
      "default": "universal"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Full contract text with terms and conditions"
    },
    "terms": {
      "type": "string",
      "description": "Key terms summary"
    },
    "ai_generated": {
      "type": "boolean",
      "default": false
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "pending",
        "validated",
        "rejected",
        "needs_review"
      ],
      "default": "pending"
    },
    "validated_by_ai": {
      "type": "boolean",
      "default": false
    },
    "validated_by_user": {
      "type": "boolean",
      "default": false
    },
    "is_standard": {
      "type": "boolean",
      "default": false,
      "description": "Standard template for this trade"
    },
    "source_url": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "data_class": {
      "type": "string",
      "enum": [
        "production",
        "NON_PRODUCTION_EXAMPLE"
      ],
      "default": "production"
    }
  },
  "required": [
    "title",
    "trade"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}