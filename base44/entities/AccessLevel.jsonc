{
  "name": "AccessLevel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of the access level"
    },
    "description": {
      "type": "string",
      "description": "What this access level grants"
    },
    "level_type": {
      "type": "string",
      "enum": [
        "system",
        "custom"
      ],
      "default": "system",
      "description": "System levels are built-in, custom are admin-created"
    },
    "category": {
      "type": "string",
      "description": "Custom category grouping (e.g. 'Field Team', 'Estimating Dept')"
    },
    "permissions": {
      "type": "array",
      "description": "List of permission keys this level grants",
      "items": {
        "type": "string"
      }
    },
    "color": {
      "type": "string",
      "description": "Hex color for UI badge",
      "default": "#3b82f6"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "data_class": {
      "type": "string",
      "enum": [
        "production",
        "NON_PRODUCTION_EXAMPLE"
      ],
      "default": "production"
    }
  },
  "required": [
    "name",
    "level_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}