{
  "name": "Material",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "unit_cost": {
      "type": "number"
    },
    "manufacturer": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "xtremepolishingsystems",
        "scraped",
        "manual",
        "supplier"
      ],
      "default": "manual"
    },
    "last_scraped_date": {
      "type": "string",
      "format": "date-time"
    },
    "alternate_allowed": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string"
    },
    "data_class": {
      "type": "string",
      "enum": [
        "production",
        "NON_PRODUCTION_EXAMPLE"
      ],
      "default": "production"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}