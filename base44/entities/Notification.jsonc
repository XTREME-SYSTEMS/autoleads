{
  "name": "Notification",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "opportunity",
        "bid_invitation",
        "takeoff",
        "proposal",
        "source_health",
        "deadline",
        "system"
      ],
      "default": "system"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "linked_route": {
      "type": "string"
    },
    "linked_record_id": {
      "type": "string"
    },
    "data_class": {
      "type": "string",
      "enum": [
        "production",
        "NON_PRODUCTION_EXAMPLE"
      ],
      "default": "production"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}