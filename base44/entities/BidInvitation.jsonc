{
  "name": "BidInvitation",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "sender": {
      "type": "string"
    },
    "received_date": {
      "type": "string",
      "format": "date-time"
    },
    "matched_project_id": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "needs_match",
        "needs_review",
        "assigned",
        "duplicate",
        "declined"
      ],
      "default": "needs_match"
    },
    "assigned_to": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "data_class": {
      "type": "string",
      "enum": [
        "production",
        "NON_PRODUCTION_EXAMPLE"
      ],
      "default": "production"
    }
  },
  "required": [
    "subject"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}