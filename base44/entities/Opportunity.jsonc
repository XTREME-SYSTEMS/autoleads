{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "qualification",
        "takeoff",
        "estimating",
        "proposal",
        "won",
        "lost"
      ],
      "default": "qualification"
    },
    "value": {
      "type": "number"
    },
    "bid_due_date": {
      "type": "string",
      "format": "date"
    },
    "bidability_score": {
      "type": "number"
    },
    "decision": {
      "type": "string",
      "enum": [
        "pursue",
        "review",
        "decline"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "authority": {
      "type": "string"
    },
    "retrieval_date": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": "number"
    },
    "last_verified_date": {
      "type": "string",
      "format": "date-time"
    },
    "data_class": {
      "type": "string",
      "enum": [
        "production",
        "NON_PRODUCTION_EXAMPLE"
      ],
      "default": "production"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}