{
  "name": "ScrapeSource",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "government_portal",
        "aggregator",
        "email",
        "api",
        "manual"
      ],
      "default": "government_portal"
    },
    "jurisdiction": {
      "type": "string"
    },
    "trades": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "error",
        "unverified"
      ],
      "default": "unverified"
    },
    "last_run_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_success_date": {
      "type": "string",
      "format": "date-time"
    },
    "records_retrieved": {
      "type": "number",
      "default": 0
    },
    "error_count": {
      "type": "number",
      "default": 0
    },
    "last_error": {
      "type": "string"
    },
    "schedule_cron": {
      "type": "string"
    },
    "parser_version": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "data_class": {
      "type": "string",
      "enum": [
        "production",
        "NON_PRODUCTION_EXAMPLE"
      ],
      "default": "production"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}