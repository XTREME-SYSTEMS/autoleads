{
  "name": "Recommendation",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "data_engine",
        "user_habit",
        "ai_automation",
        "operational_fix",
        "virality",
        "ui_fix",
        "other"
      ],
      "default": "other"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "in_progress",
        "done",
        "deferred"
      ],
      "default": "proposed"
    },
    "description": {
      "type": "string"
    },
    "impact": {
      "type": "string",
      "description": "What value this delivers to the business or user"
    },
    "effort": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large"
      ],
      "default": "medium"
    },
    "source": {
      "type": "string",
      "description": "Where the recommendation originated (e.g. 'vision audit', 'system audit')"
    },
    "data_class": {
      "type": "string",
      "enum": [
        "production",
        "NON_PRODUCTION_EXAMPLE"
      ],
      "default": "production"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": { "$in": "{{user.data.organization_ids}}" }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}